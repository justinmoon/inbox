{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "bundle_version": {
      "type": "number",
      "const": 2
    },
    "project": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "worktree_path": {
          "type": "string",
          "minLength": 1
        },
        "repo_path": {
          "type": "string",
          "minLength": 1
        },
        "created_at": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "name",
        "worktree_path",
        "repo_path",
        "created_at"
      ],
      "additionalProperties": false
    },
    "change_unit": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "project_id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "in_progress",
            "awaiting_review",
            "needs_revision",
            "approved",
            "ready_to_land",
            "landed"
          ]
        },
        "tutorial": {
          "type": "object",
          "properties": {
            "executive_summary": {
              "type": "string",
              "minLength": 1
            },
            "steps": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1
                  },
                  "intent": {
                    "type": "string",
                    "minLength": 1
                  },
                  "affected_files": {
                    "default": [],
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "evidence_snippets": {
                    "default": [],
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "minLength": 1
                        },
                        "label": {
                          "type": "string",
                          "minLength": 1
                        },
                        "language": {
                          "type": "string",
                          "minLength": 1
                        },
                        "snippet": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "required": [
                        "id",
                        "label",
                        "snippet"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "body_markdown": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "id",
                  "title",
                  "intent",
                  "affected_files",
                  "evidence_snippets",
                  "body_markdown"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "executive_summary",
            "steps"
          ],
          "additionalProperties": false
        },
        "next_action": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "codex_fork_path"
                },
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "prompt": {
                  "type": "string",
                  "minLength": 1
                },
                "cwd": {
                  "type": "string",
                  "minLength": 1
                },
                "label": {
                  "type": "string",
                  "minLength": 1
                },
                "role": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "kind",
                "path",
                "prompt"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "codex_resume_thread"
                },
                "thread_id": {
                  "type": "string",
                  "minLength": 1
                },
                "prompt": {
                  "type": "string",
                  "minLength": 1
                },
                "cwd": {
                  "type": "string",
                  "minLength": 1
                },
                "label": {
                  "type": "string",
                  "minLength": 1
                },
                "role": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "kind",
                "thread_id",
                "prompt"
              ],
              "additionalProperties": false
            }
          ]
        },
        "diff": {
          "type": "string",
          "minLength": 1
        },
        "created_at": {
          "type": "string",
          "minLength": 1
        },
        "updated_at": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "project_id",
        "title",
        "status",
        "tutorial",
        "diff",
        "created_at",
        "updated_at"
      ],
      "additionalProperties": false
    },
    "agent_sessions": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "change_unit_id": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "minLength": 1
          },
          "runtime": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "minLength": 1
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "milestones": {
            "default": [],
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "timestamp": {
                  "type": "string",
                  "minLength": 1
                },
                "label": {
                  "type": "string",
                  "minLength": 1
                },
                "description": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "id",
                "timestamp",
                "label"
              ],
              "additionalProperties": false
            }
          },
          "thread_capture": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "rollout_path"
                  },
                  "path": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "kind",
                  "path"
                ],
                "additionalProperties": false
              }
            ]
          },
          "transcript": {
            "type": "object",
            "properties": {
              "summary": {
                "type": "string",
                "minLength": 1
              },
              "turns": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "label": {
                      "type": "string",
                      "minLength": 1
                    },
                    "timestamp": {
                      "type": "string",
                      "minLength": 1
                    },
                    "status": {
                      "type": "string",
                      "minLength": 1
                    },
                    "items": {
                      "minItems": 1,
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string",
                            "minLength": 1
                          },
                          "type": {
                            "type": "string",
                            "enum": [
                              "user",
                              "assistant",
                              "tool",
                              "system",
                              "note"
                            ]
                          },
                          "title": {
                            "type": "string",
                            "minLength": 1
                          },
                          "text": {
                            "type": "string",
                            "minLength": 1
                          },
                          "command": {
                            "type": "string",
                            "minLength": 1
                          },
                          "output": {
                            "type": "string",
                            "minLength": 1
                          },
                          "status": {
                            "type": "string",
                            "minLength": 1
                          },
                          "exit_code": {
                            "type": "integer",
                            "minimum": -9007199254740991,
                            "maximum": 9007199254740991
                          },
                          "duration_ms": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 9007199254740991
                          },
                          "timestamp": {
                            "type": "string",
                            "minLength": 1
                          }
                        },
                        "required": [
                          "id",
                          "type"
                        ],
                        "additionalProperties": false
                      }
                    }
                  },
                  "required": [
                    "id",
                    "timestamp",
                    "items"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "turns"
            ],
            "additionalProperties": false
          },
          "created_at": {
            "type": "string",
            "minLength": 1
          },
          "updated_at": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "change_unit_id",
          "role",
          "runtime",
          "status",
          "milestones",
          "created_at",
          "updated_at"
        ],
        "additionalProperties": false
      }
    },
    "review_verdicts": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "change_unit_id": {
            "type": "string",
            "minLength": 1
          },
          "reviewer_role": {
            "type": "string",
            "minLength": 1
          },
          "verdict": {
            "type": "string",
            "enum": [
              "approve",
              "needs_revision",
              "comment",
              "blocked"
            ]
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "details_markdown": {
            "type": "string",
            "minLength": 1
          },
          "created_at": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "change_unit_id",
          "reviewer_role",
          "verdict",
          "summary",
          "created_at"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "bundle_version",
    "project",
    "change_unit",
    "agent_sessions",
    "review_verdicts"
  ],
  "additionalProperties": false
}
